# For .env: mounted from a 1Password Environment, or copied from this file and
# filled in. .env is not committed. The names are the ones `tauri build` reads
# to sign and notarise; scripts/notary.sh reads the Apple ID ones.
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_PASSWORD=
# scripts/build-acme-app.sh signs test app archives with these: base64, on one
# line, of a throwaway leaf.pem and leaf.key from make-app-archive.sh keys.
OPCA_TEST_SIGNING_CERT=
OPCA_TEST_SIGNING_KEY=
