# Copy to .env and fill in. Every variable is read by acme-client.sh.

# --- Required ---

# The ACME server's directory URL.
ACME_SERVER=https://broker.example.com:8443/acme/directory
# The account's contact address. lego accepts the server's terms of service on your behalf.
ACME_EMAIL=ops@example.com
# The names on the certificate, comma-separated. The first names the files under ACME_DATA.
ACME_DOMAINS=app.example.com,www.app.example.com
# http (http-01 on port 80), tls (tls-alpn-01 on port 443) or dns:<lego provider>, such as
# dns:cloudflare. The opCA broker offers whichever its issuance config allows.
ACME_CHALLENGE=http
# The PEM roots that the server's TLS certificate chains to, inside the container. For an opCA
# broker, the CA's root certificate; for a public CA, /etc/ssl/certs/ca-certificates.crt.
# compose.yaml mounts ./ca.pem here.
ACME_CA_BUNDLE=/etc/acme/ca.pem

# --- Optional ---

# rsa2048, rsa3072, rsa4096, rsa8192, ec256 or ec384.
#ACME_KEY_TYPE=ec256
# Renew once the certificate has this many days left. 10 suits the broker's 30-day leaves.
#ACME_RENEW_DAYS=10
# Seconds between renewal checks.
#ACME_CHECK_INTERVAL=43200
# Seconds before trying again after a failed order, renewal or hook.
#ACME_RETRY_INTERVAL=3600
# Run under sh after each issue or renewal, with ACME_CERT (the certificate and its chain) and
# ACME_KEY set to the files' paths.
#ACME_HOOK='cp "$ACME_CERT" "$ACME_KEY" /shared/tls/'
# Where lego keeps the account and certificates.
#ACME_DATA=/data
# 1 to issue or renew once and exit, for cron or a one-shot job.
#ACME_ONCE=1
# More lego global options, split on spaces, e.g. --http.port :8080 or --http.webroot /srv/www.
#ACME_ARGS=

# --- Passed straight to lego ---

# A DNS provider's own variables, for ACME_CHALLENGE=dns:<provider>. See `lego dnshelp -c <provider>`.
#CLOUDFLARE_DNS_API_TOKEN=
# External account binding, for a server that needs it. The opCA broker does not.
#LEGO_EAB=true
#LEGO_EAB_KID=
#LEGO_EAB_HMAC=
